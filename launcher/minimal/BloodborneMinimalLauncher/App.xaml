<Application x:Class="BloodborneMinimalLauncher.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="BackgroundBrush" Color="#211713" />
  <SolidColorBrush x:Key="PanelBrush" Color="#302019" />
  <SolidColorBrush x:Key="GoldBrush" Color="#D8B66A" />
  <SolidColorBrush x:Key="RedBrush" Color="#4B1716" />
  <SolidColorBrush x:Key="TextBrush" Color="#F0E4D0" />
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
   <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#F0E4D0" />
   <Setter Property="Background" Value="#38251F" />
   <Setter Property="BorderBrush" Value="#79513A" />
   <Setter Property="Padding" Value="6,4" />
   <Setter Property="MinWidth" Value="170" />
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F0E4D0" />
   <Setter Property="Background" Value="#38251F" />
   <Setter Property="Padding" Value="6,5" />
   <Style.Triggers>
    <Trigger Property="IsHighlighted" Value="True">
     <Setter Property="Background" Value="#4B1716" />
     <Setter Property="Foreground" Value="#D8B66A" />
    </Trigger>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="#4B1716" />
     <Setter Property="Foreground" Value="#F0E4D0" />
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
   <Setter Property="Margin" Value="0,6,0,6" />
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#FFF1D5" />
   <Setter Property="Background" Value="{StaticResource RedBrush}" />
   <Setter Property="BorderBrush" Value="#79513A" />
   <Setter Property="Padding" Value="14,8" />
   <Setter Property="Margin" Value="0,0,8,0" />
   <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
 </Application.Resources>
</Application>
