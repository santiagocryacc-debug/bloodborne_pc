<Window x:Class="BloodborneMinimalLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Bloodborne" Width="480" Height="535" MinWidth="450" MinHeight="500"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="BLOODBORNE" Foreground="{StaticResource GoldBrush}" FontSize="24" FontWeight="Bold" Margin="0,0,0,18" />
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Background="{StaticResource PanelBrush}" Padding="16" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="DISPLAY" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" Margin="0,0,0,12" />
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Resolution"/><ComboBox x:Name="ResolutionBox" Grid.Column="1" HorizontalAlignment="Stretch"/></Grid>
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Presentation Mode"/><ComboBox x:Name="PresentationBox" Grid.Column="1" HorizontalAlignment="Stretch"/></Grid>
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Frame Cap"/><ComboBox x:Name="FrameCapBox" Grid.Column="1" HorizontalAlignment="Stretch"/></Grid>
      <CheckBox x:Name="FullscreenBox" Content="Fullscreen" HorizontalAlignment="Left" />
      <CheckBox x:Name="HideMouseBox" Content="Hide Mouse" HorizontalAlignment="Left" />
      <CheckBox x:Name="WidescreenBox" Content="Widescreen Support" HorizontalAlignment="Left" />
      <CheckBox x:Name="LiveResolutionBox" Content="Live Resolution Change" HorizontalAlignment="Left" />
     </StackPanel>
    </Border>
    <Border Background="{StaticResource PanelBrush}" Padding="16" Margin="0,0,0,8">
     <StackPanel>
      <TextBlock Text="GRAPHICS" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" Margin="0,0,0,12" />
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Upscaler"/><ComboBox x:Name="UpscalerBox" Grid.Column="1" HorizontalAlignment="Stretch"/></Grid>
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Upscaling Preset"/><ComboBox x:Name="PresetBox" Grid.Column="1" HorizontalAlignment="Stretch"/></Grid>
      <CheckBox x:Name="SharpenBox" Content="Sharpening (RCAS)" HorizontalAlignment="Left" />
      <CheckBox x:Name="ObjectMotionBox" Content="Object Motion Vectors" HorizontalAlignment="Left" />
      <CheckBox x:Name="ShowFpsBox" Content="Show FPS Counter" HorizontalAlignment="Left" />
      <TextBlock Text="GAME EFFECTS" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" Margin="0,12,0,8" />
      <CheckBox x:Name="SsaoBox" Content="Ambient Occlusion (SSAO)" HorizontalAlignment="Left" />
      <CheckBox x:Name="DynamicShadowsBox" Content="Dynamic Light Shadows" HorizontalAlignment="Left" />
      <CheckBox x:Name="ChromaticAberrationBox" Content="Chromatic Aberration" HorizontalAlignment="Left" />
      <CheckBox x:Name="DepthOfFieldBox" Content="Depth Of Field" HorizontalAlignment="Left" />
      <CheckBox x:Name="MotionBlurBox" Content="Motion Blur" HorizontalAlignment="Left" />
      <CheckBox x:Name="GameAaBox" Content="Game Own Anti-Aliasing" HorizontalAlignment="Left" />
      <CheckBox x:Name="ScreenSpaceReflectionsBox" Content="Screen-Space Reflections" HorizontalAlignment="Left" />
     </StackPanel>
    </Border>
    <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap" Margin="0,2,0,4" />
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,10,0,10">
   <Button x:Name="ChoosePortButton" Content="CHOOSE PORT FOLDER" Click="ChoosePort_Click" HorizontalAlignment="Stretch" Margin="0" Padding="12,9"/>
  </Grid>
  <Button Grid.Row="3" Content="SAVE SETTINGS" Click="Save_Click" HorizontalAlignment="Stretch" Margin="0" Padding="12,12" FontSize="14"/>
 </Grid>
</Window>
