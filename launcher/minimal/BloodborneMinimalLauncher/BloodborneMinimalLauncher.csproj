<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.9.39-beta.31</Version>
    <FileVersion>0.9.39.31</FileVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Launcher</AssemblyName>
    <ApplicationIcon>Bloodborne.ico</ApplicationIcon>
    <RootNamespace>BloodborneMinimalLauncher</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Bloodborne.ico" />
  </ItemGroup>
</Project>
