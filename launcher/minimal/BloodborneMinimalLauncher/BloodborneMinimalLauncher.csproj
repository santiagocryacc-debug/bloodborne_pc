<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Bloodborne Minimal Launcher</AssemblyName>
    <ApplicationIcon>Bloodborne.ico</ApplicationIcon>
    <RootNamespace>BloodborneMinimalLauncher</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Bloodborne.ico" />
    <Content Include="Bloodborne.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
